class_name FlightData
extends RefCounted
## Числа полёта еды и подсчёта удачи для счётчика в полёте (T40). Только данные, без узлов.

## Траектория: низкая и почти прямая, высота дуги растёт с дальностью очень медленно.
const ARC_PER_M: float = 0.012    # высота дуги на метр дальности
const ARC_MIN_M: float = 1.5      # минимальная высота дуги
const ARC_MAX_M: float = 12.0     # максимальная высота дуги (даже на 2000 м бросок остаётся пологим)

## Время полёта: 0.9 с + дальность / 300, не больше 4 с (раньше было 0.9 + дальность / 500, не больше 3 с).
const TIME_BASE_S: float = 0.9
const TIME_PER_M: float = 1.0 / 300.0
const TIME_MAX_S: float = 4.0

## Множитель удачи за «Идеально!» (R3, редакция 3: luck = round(dist * food.luck * 1.25)).
## ВАЖНО: это копия множителя из расчёта SCORE; если в проекте он уже лежит в одном месте, брать оттуда.
const PERFECT_LUCK_MULT: float = 1.25
